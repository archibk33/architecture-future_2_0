<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.0.4 Chrome/138.0.7204.97 Electron/37.2.1 Safari/537.36" version="28.0.4">
  <diagram id="roadmap" name="Roadmap">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Линия времени -->
        <mxCell id="line" style="edgeStyle=segmentEdgeStyle;endArrow=classic;html=1;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry width="100" height="100" relative="1" as="geometry">
            <mxPoint x="140" y="420" as="sourcePoint" />
            <mxPoint x="1700" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Этапы -->
        <mxCell id="q1" value="Этап 1 Портал самообслуживания и IdP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="160" y="320" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="Этап 2 Облачный DWH и оркестрация ETL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="520" y="320" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="Этап 3 Платформа потоков и интеграции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="900" y="320" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q4" value="Этап 4 Каталог данных и витрины BI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="1280" y="320" width="320" height="80" as="geometry" />
        </mxCell>
        <!-- Связи -->
        <mxCell id="e12" style="endArrow=block;strokeColor=#666666;" parent="1" source="q1" target="q2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="endArrow=block;strokeColor=#666666;" parent="1" source="q2" target="q3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="endArrow=block;strokeColor=#666666;" parent="1" source="q3" target="q4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Результаты -->
        <mxCell id="r1" value="Результат Сокращение времени отчетности" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" parent="1" vertex="1">
          <mxGeometry x="180" y="220" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Результат Независимость доменов и новые интеграции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" parent="1" vertex="1">
          <mxGeometry x="560" y="220" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Результат Масштабирование и событие как интерфейс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" parent="1" vertex="1">
          <mxGeometry x="920" y="220" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Результат Прозрачность и ролевой доступ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" parent="1" vertex="1">
          <mxGeometry x="1320" y="220" width="280" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

